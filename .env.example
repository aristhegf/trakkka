# ---- Supabase (Project settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://aacluaqznzfgstwirbhk.supabase.co
# Publishable (anon) key: safe in the browser ONLY because RLS is enabled on every table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Service role / secret key: server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
# Public origin, used for auth redirects and email links.
# AssetWatch always runs on port 4127 locally (fixed on purpose, see package.json "dev"/"start"
# scripts) so it never collides with another project's default :3000 dev server.
NEXT_PUBLIC_APP_URL=http://localhost:4127
# Shared secret between pg_cron (Vault: assetwatch_dispatch_secret) and /api/notify/dispatch. `openssl rand -hex 32`
NOTIFY_DISPATCH_SECRET=

# ---- Map (all optional; defaults to OpenFreeMap, no key, commercial use OK, no SLA) ----
# NEXT_PUBLIC_MAP_STYLE_LIGHT=https://api.maptiler.com/maps/streets-v2/style.json?key=...
# NEXT_PUBLIC_MAP_STYLE_DARK=https://api.maptiler.com/maps/streets-v2-dark/style.json?key=...
# Satellite toggle: either a MapTiler key (hybrid style) ...
# NEXT_PUBLIC_MAPTILER_KEY=
# ... or any raster XYZ template you are licensed to use (e.g. Esri World Imagery via ArcGIS Location Platform, attribution required).
# NEXT_PUBLIC_SATELLITE_TILE_URL=https://ibasemaps-api.arcgis.com/arcgis/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}?token=...
# NEXT_PUBLIC_SATELLITE_ATTRIBUTION=Esri, Maxar, Earthstar Geographics

# ---- Reverse geocoding (optional; OpenCage permits caching results) ----
# OPENCAGE_API_KEY=

# ---- Email alerts (optional; Resend) ----
# RESEND_API_KEY=
# ALERT_EMAIL_FROM="AssetWatch <alerts@yourdomain.com>"
